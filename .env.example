# Optional retained EmailJS contact form (the studio uses a mailto link).
# These are browser-public identifiers, never private API credentials.
VITE_SERVICE_ID=
VITE_TEMPLATE_ID=
VITE_PUBLIC_KEY=

# Optional local sync overrides (shell environment; never VITE_ variables).
# The registry must stay inside this project's ignored memory/ folder.
PROJECT_SYNC_REGISTRY=memory/project-sync/registry.json
PROJECT_SYNC_SERVICE_ACCOUNT=
PROJECT_SYNC_TOKEN_FILE=
